{
  "description": "Checkpoints de conversa.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/chat-memory.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $repo = (git rev-parse --show-toplevel); & (Join-Path $repo '.codex/hooks/chat-memory.ps1') }\"",
            "timeout": 5,
            "statusMessage": "Buscando checkpoints",
            "additionalContextLimit": 3500
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$(git rev-parse --show-toplevel)/.codex/hooks/chat-memory.ps1\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $repo = (git rev-parse --show-toplevel); & (Join-Path $repo '.codex/hooks/chat-memory.ps1') }\"",
            "timeout": 5,
            "statusMessage": "Salvando checkpoint"
          }
        ]
      }
    ]
  }
}
